  "description": "Backend for PYPE CRM",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "node --max-old-space-size=3072 node_modules/typescript/bin/tsc",
    "postbuild": "node copy-prisma.js",
    "lint": "eslint src/**/*.ts",
    "studio": "prisma studio --port 5555",
    "migrate": "npx prisma db push --accept-data-loss && npx prisma generate",
    "seed": "ts-node src/scripts/seed.ts",
    "postinstall": "npx prisma generate && node copy-prisma.js"
  },
