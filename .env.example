# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Formats: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/crm

# Authentication
JWT_SECRET=generate_a_long_random_string_here

# OpenAI Integration
OPENAI_API_KEY=sk-proj-xxx

# Gemini Integration (Training Assistant chatbot, next-step suggestions)
GEMINI_API_KEY=AIzaSy-xxx

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_xxx

# Meta / Marketing API
META_APP_ID=xxx
META_APP_SECRET=xxx
META_WEBHOOK_SECRET=xxx
META_VERIFY_TOKEN=xxx
# Who gets emailed when the Meta lead-polling cron fails for an org. Optional -
# falls back to a placeholder address if unset.
META_POLLING_ALERT_EMAIL=alerts@pypecrm.com

# WhatsApp (Meta)
WHATSAPP_VERSION=v17.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp (Gallabox)
GALLABOX_WEBHOOK_SECRET=

# Firebase Admin (mobile push notifications via FCM)
# Full JSON contents of a service account key, as a single-line string
# (Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key). Leave unset to disable push — in-app/email notifications
# are unaffected either way.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Redis Configuration

# Security
SESSION_SECRET=xxx
CSRF_SECRET=xxx

# CORS / Frontend
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth (Gmail Integration)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/settings/gmail-callback

# Centralized call-recording bridge (Dad-dialer's server-number/
# conference-bridge method — see Dad-dialer/CALL_RECORDING_SERVER_METHOD_PLAN.md).
# ONE PypeCRM-owned Twilio account for this feature, deliberately separate
# from any org's own per-org integrations.twilio (that's the unrelated
# desktop click-to-call flow). PLATFORM_TWILIO_BRIDGE_NUMBERS is a
# comma-separated pool of Twilio numbers this account owns; leave unset to
# keep the feature fully inert (resolveBridgeConfigForOrg() then always
# returns bridgeNumber: null regardless of any org's opt-in).
# PLATFORM_TWILIO_BRIDGE_NUMBERS is the only one telephonyBridgeService.ts
# actually reads today (a comma-separated pool of Twilio numbers this
# account owns) — the webhooks only ever receive inbound calls and answer
# with TwiML, no outbound Twilio API calls yet. ACCOUNT_SID/AUTH_TOKEN are
# reserved for later hardening (Twilio request-signature verification,
# programmatic number provisioning) and are not consumed by any code path
# yet — leave them set anyway so they're ready when that lands.
PLATFORM_TWILIO_ACCOUNT_SID=
PLATFORM_TWILIO_AUTH_TOKEN=
PLATFORM_TWILIO_BRIDGE_NUMBERS=
