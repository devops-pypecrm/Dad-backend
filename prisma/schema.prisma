model WhatsAppMessage {
  id                String    @id @default(uuid())
  conversationId    String
  phoneNumber       String
  direction         String // 'incoming' or 'outgoing'
  messageType       String    @default("text") // 'text', 'image', 'document', 'audio', 'video', 'location', 'template', 'interactive'
  content           Json? // Flexible content storage
  status            String    @default("pending") // 'pending', 'sent', 'delivered', 'read', 'failed'
  waMessageId       String? // WhatsApp message ID
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  organisationId    String
  leadId            String?
  contactId         String?
  agentId           String?
  campaignId        String?
  whatsappAccountId String?
  isReadByAgent     Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isDeleted         Boolean   @default(false)

  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead            Lead?             @relation(fields: [leadId], references: [id])
  contact         Contact?          @relation(fields: [contactId], references: [id])
  agent           User?             @relation("WhatsAppMessageAgent", fields: [agentId], references: [id])
  campaign        WhatsAppCampaign? @relation(fields: [campaignId], references: [id])
  whatsappAccount WhatsAppAccount?  @relation(fields: [whatsappAccountId], references: [id])

  @@unique([organisationId, waMessageId])
  @@index([conversationId, createdAt])
  @@index([leadId])
  @@index([phoneNumber])
  @@index([organisationId])
  @@index([organisationId, isDeleted, createdAt])
  @@index([whatsappAccountId])
}

model WhatsAppAccount {
  id             String   @id @default(uuid())
