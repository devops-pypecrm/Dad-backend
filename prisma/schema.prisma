model Interaction {
  id                String               @id @default(uuid())
  type              InteractionType
  direction         InteractionDirection @default(outbound)
  subject           String
  description       String?
  date              DateTime             @default(now())
  duration          Float?
  recordingUrl      String?
  recordingDuration Int?
  hardwareDuration  Int? // Official carrier talk-time in seconds
  callStatus        String?
  phoneNumber       String?
  callerId          String?
  hardwareId        String? // Official Android CallLog _ID for zero-error deduplication
  callSessionId     String? // Unique UUID generated by the app for the duration of the call
  leadId            String?
  contactId         String?
  accountId         String?
  opportunityId     String?
  createdById       String?
  organisationId    String?
  documentId        String? // Link to Document containing the recording file
  document          Document?            @relation(fields: [documentId], references: [id])
  isDeleted         Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  account           Account?             @relation(fields: [accountId], references: [id])
  contact           Contact?             @relation(fields: [contactId], references: [id])
  createdBy         User?                @relation("InteractionCreator", fields: [createdById], references: [id])
  lead              Lead?                @relation(fields: [leadId], references: [id])
  opportunity       Opportunity?         @relation(fields: [opportunityId], references: [id])
  organisation      Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?              @relation(fields: [branchId], references: [id])

  @@unique([organisationId, callSessionId])
  @@unique([organisationId, hardwareId])
  @@index([branchId])
  @@index([organisationId])
  @@index([organisationId, createdAt])
  // Backs androidController.ts's `syncCallLogs` fuzzy-reconciliation
  // fallback (both the 'initiated'-within-24h and the completed/missed/
  // failed/rejected-within-1h findFirst queries) — both filter on exactly
  // this column set (createdById equality, phoneNumber IN a small set of
  // formatted variations, date as a range last). Without it, every Android
  // sync call that doesn't exact-match by callSessionId/hardwareId forces
  // a scan of the filtering org+user's whole call history; this matters
  // more as more devices sync concurrently, not less.
  @@index([organisationId, createdById, phoneNumber, date])
  // Backs the `interactions: { none: {...} } ` relational filter used by
  // the Dashboard's Lead Health tiles (`getLeadHealth` in
  // analyticsController.ts) and their click-through list endpoints
  // (`getUnattendedLeads`/`getNoActivityLeads` in leadController.ts) —
  // both compile to a correlated NOT EXISTS subquery keyed on `leadId`.
  // Without this, Postgres had to sequentially scan the entire
  // (org-wide, potentially tens of thousands of rows) Interaction table
  // once per candidate Lead, which is what was timing out the mobile
  // app's "Unattended"/"No Activity" screens. Leading column `leadId`
  // also covers the plain `interactions: { none: {} }` (no date filter)
  // case the "unattended" query uses.
  @@index([leadId, date])
}

