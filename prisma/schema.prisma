model AuditLog {
  id             String   @id @default(uuid())
  action         String // CREATE, UPDATE, DELETE, LOGIN, LOGIN_FAILED, EXPORT
  entity         String // Lead, Contact, User, Settings, etc.
  entityId       String?
  actorId        String? // User who performed the action
  details        Json? // { old: ..., new: ..., metadata: ... }
  ipAddress      String?
  userAgent      String?
  organisationId String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organisationId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([actorId])
  @@index([organisationId, createdAt])
  @@index([organisationId, actorId, createdAt])
}

// Structured activity log uploaded by the PypeCRM Helper (Dad-call-recorder)
// sideloaded companion app — call-detection, call-log reconciliation, and
// bulk-sync events, batched from the device's local EngineDebugLog ring
// buffer. Read by the super-admin "Helper Logs" panel (Dad-frontend), not
// exposed to normal org users.
model HelperActivityLog {
  id              String   @id @default(uuid())
  organisationId  String
  userId          String
  event           String // e.g. CALL_DETECTED, CALL_LOG_RECONCILED, BULK_SYNC_SUCCESS, BULK_SYNC_FAILED, BULK_SYNC_RATE_LIMITED, TIER0_MATCH_FOUND, TIER0_NO_MATCH
  detail          String?
  level           String   @default("info") // info | warn | error
  clientTimestamp DateTime // when the event actually happened on-device, per EngineDebugLog's timestampMillis
  createdAt       DateTime @default(now()) // when the server received/stored it

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Document {
  id          String    @id @default(uuid())
  name        String
  description String?
  fileKey     String // Original filename or identifier
  fileUrl     String? // Optional: for backward compatibility
  fileData    Bytes? // Binary file data stored in database
  fileType    String
  fileSize    Int
  category    String?   @default("other")
  tags        String[]
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("DocumentCreator", fields: [createdById], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  opportunityId String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])
  interactions  Interaction[]

  @@index([organisationId])
  @@index([leadId])
  @@index([contactId])
  @@index([accountId])
  @@index([opportunityId])
}

