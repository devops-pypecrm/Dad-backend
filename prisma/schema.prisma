// Platform-level bug/issue reports raised by any user about the CRM itself (distinct
// from `Case`, which is a tenant's own customer-support ticket). Visible to the
// reporter and to the platform super admin only — see issueController.ts.
model IssueReport {
  id          String    @id @default(uuid())
  title       String
  description String
  issueType   String    @default("bug") // 'bug' | 'feature_request' | 'question' | 'other'
  priority    String    @default("medium") // 'low' | 'medium' | 'high' | 'critical'
  status      String    @default("open") // 'open' | 'in_progress' | 'resolved' | 'closed'
  attachments Json? // [{ documentId, url, name }] or, once cleaned up, [{ name, removed: true }]
  closedAt    DateTime? // set when status becomes 'closed' — anchors the retention cleanup schedule
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   User   @relation("IssueReporter", fields: [reportedById], references: [id])

  replies IssueReply[]

  @@index([organisationId])
  @@index([reportedById])
  @@index([status])
}

