generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  domain                  String?                  @unique
  logo                    String?
  subscription            Json?
  contactEmail            String?
  contactPhone            String?
  address                 String?
  status                  String                   @default("active")
  userLimit               Int                      @default(5)
  contactLimit            Int                      @default(500)
  storageLimit            Int                      @default(1000) // MB
  currency                String                   @default("USD")
  userIdCounter           Int                      @default(0)
  apiKey                  String?
  integrations            Json?
  leadScoringConfig       Json?
  dailyReportTime         String                   @default("09:00") // Time to send daily business report (HH:mm)
  dailyReportEmailEnabled Boolean                  @default(false)
  // Outstanding balance owed, computed from the org's active License.customPrice
  // x current user count x months elapsed since billingStartDate. No invoice/
  // ledger table exists yet - this is a running total, recomputed and
  // overwritten whenever billing is reconciled (e.g. super-admin "recalculate
  // dues" action), not an append-only history.
  amountDue               Float?                   @default(0)
  billingStartDate        DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  isDeleted               Boolean                  @default(false)
  deletedAt               DateTime?
  createdBy               String?
  upsellConfig            Json?
  ssoConfig               Json?
  whatsAppScrapingEnabled Boolean                  @default(false)
  leadStatuses            Json? // Custom lead status configuration: [{ id, label, color, isSystem, order }]
  opportunityLeadStatuses Json? // Custom opportunity lead status configuration: [{ id, label, color, isSystem, order }]
  accounts                Account[]
  apiKeys                 ApiKey[]
  assignmentRules         AssignmentRule[]
  events                  CalendarEvent[]
  callSettings            CallSettings?
  campaigns               Campaign[]
  cases                   Case[]
  checkIns                CheckIn[]
  contacts                Contact[]
  customFields            CustomField[]
  emailLists              EmailList[]
  goals                   Goal[]
  interactions            Interaction[]
  issueReports            IssueReport[]
  leads                   Lead[]
  licenses                License[]
  opportunities           Opportunity[]
  products                Product[]
  quotes                  Quote[]
  salesTargets            SalesTarget[]
  tasks                   Task[]
  followUps               FollowUp[]
  territories             Territory[]
  users                   User[]
  webhooks                Webhook[]
  workflows               Workflow[]
  workflowRules           WorkflowRule[]
  importJobs              ImportJob[]
  pipelines               Pipeline[]
  webForms                WebForm[]
  smsCampaigns            SMSCampaign[]
  whatsAppCampaigns       WhatsAppCampaign[]
  whatsAppMessages        WhatsAppMessage[]
  whatsAppAccounts        WhatsAppAccount[]
  whatsAppAssignmentRules WhatsAppAssignmentRule[]
  whatsAppFlows           WhatsAppFlow[]
  commissions             Commission[]
  landingPages            LandingPage[]
  auditLogs               AuditLog[]
  queueItems              WorkflowQueue[]
  teams                   Team[]
  accountProducts         AccountProduct[]
  documents               Document[]
  productShares           ProductShare[]
  branches                Branch[]
  rolePermissions         Role[]
  emiSchedules            EMISchedule[]
  paymentRecords          PaymentRecord[]
  helperActivityLogs      HelperActivityLog[]
  shufflerConfig          Json?
  convertedFromEnquiry    Enquiry?
}

model User {
  id                             String                   @id @default(uuid())
  firstName                      String
  lastName                       String
  email                          String                   @unique
  userId                         String?                  @unique
  password                       String
  plainPassword                  String?
  role                           String                   @default("sales_rep")
  position                       String?
  phone                          String?
  profileImage                   String? // URL to profile image
  isPlaceholder                  Boolean                  @default(false)
  isActive                       Boolean                  @default(true)
  isOffDuty                      Boolean                  @default(false)
  lastLogin                      DateTime?
  integrations                   Json?
  metaAccessToken                String? // Facebook User Access Token
  metaUserId                     String?
  notificationPreferences        Json?
  fcmToken                       String? // Mobile push (FCM) device token, overwritten on each login/registration
  fcmTokenUpdatedAt              DateTime?
  resetPasswordToken             String?
  resetPasswordExpire            DateTime?
  tokenVersion                   Int                      @default(0)
  workingHours                   Json?
  timezone                       String                   @default("UTC")
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  isDeleted                      Boolean                  @default(false)
  deletedAt                      DateTime?
  organisationId                 String?
  reportsToId                    String?
  permissions                    String[]
  dailyLeadQuota                 Int?
  ownedAccounts                  Account[]                @relation("AccountOwner")
  createdApiKeys                 ApiKey[]                 @relation("ApiKeyCreator")
  createdAssignmentRules         AssignmentRule[]         @relation("RuleCreator")
  lastAssignedAssignmentRules    AssignmentRule[]         @relation("RuleLastUser")
  managedAssignmentRules         AssignmentRule[]         @relation("RuleManager")
  createdEvents                  CalendarEvent[]          @relation("EventCreator")
  createdCampaigns               Campaign[]               @relation("CampaignCreator")
  assignedCases                  Case[]                   @relation("CaseAssignee")
  createdCases                   Case[]                   @relation("CaseCreator")
  checkIns                       CheckIn[]
  sessions                       UserSession[]
  ownedContacts                  Contact[]                @relation("ContactOwner")
  createdCustomFields            CustomField[]            @relation("CustomFieldCreator")
  createdDocTemplates            DocumentTemplate[]       @relation("DocTemplateCreator")
  createdEmailLists              EmailList[]              @relation("EmailListCreator")
  assignedGoals                  Goal[]                   @relation("GoalAssignee")
  createdGoals                   Goal[]                   @relation("GoalCreator")
  createdInteractions            Interaction[]            @relation("InteractionCreator")
  assignedLeads                  Lead[]                   @relation("AssignedTo")
  previousLeads                  Lead[]                   @relation("LeadPreviousOwner")
  createdLeads                   Lead[]                   @relation("LeadCreator")
  historyChanger                 LeadHistory[]            @relation("HistoryChanger")
  historyNewOwner                LeadHistory[]            @relation("HistoryNewOwner")
  historyOldOwner                LeadHistory[]            @relation("HistoryOldOwner")
  activatedLicenses              License[]                @relation("LicenseActivator")
  cancelledLicenses              License[]                @relation("LicenseCanceller")
  notifications                  Notification[]           @relation("NotificationRecipient")
  ownedOpportunities             Opportunity[]            @relation("OpportunityOwner")
  createdProducts                Product[]                @relation("ProductCreator")
  assignedQuotes                 Quote[]                  @relation("QuoteAssignee")
  createdQuotes                  Quote[]                  @relation("QuoteCreator")
  createdSMSTemplates            SMSTemplate[]            @relation("SMSTemplateCreator")
  createdSalesTargets            SalesTarget[]            @relation("TargetCreator")
  assignedSalesTargets           SalesTarget[]            @relation("TargetAssignee")
  assignedTasks                  Task[]                   @relation("TaskAssignee")
  createdTasks                   Task[]                   @relation("TaskCreator")
  assignedFollowUps              FollowUp[]               @relation("FollowUpAssignee")
  createdFollowUps               FollowUp[]               @relation("FollowUpCreator")
  managedTerritories             Territory[]              @relation("TerritoryManager")
  previousAccounts               Account[]                @relation("AccountPreviousOwner")
  previousContacts               Contact[]                @relation("ContactPreviousOwner")
  previousOpportunities          Opportunity[]            @relation("OpportunityPreviousOwner")
  previousTasks                  Task[]                   @relation("TaskPreviousOwner")
  previousCases                  Case[]                   @relation("CasePreviousOwner")
  previousQuotes                 Quote[]                  @relation("QuotePreviousOwner")
  previousGoals                  Goal[]                   @relation("GoalPreviousOwner")
  previousSalesTargets           SalesTarget[]            @relation("SalesTargetPreviousOwner")
  organisation                   Organisation?            @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  reportsTo                      User?                    @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates                   User[]                   @relation("UserHierarchy")
  leadQuotaTracking              UserLeadQuotaTracker[]
  createdWebhooks                Webhook[]                @relation("WebhookCreator")
  createdWorkflows               Workflow[]               @relation("WorkflowCreator")
  createdRules                   WorkflowRule[]           @relation("WorkflowRuleCreator")
  createdImportJobs              ImportJob[]              @relation("ImportJobCreator")
  createdPipelines               Pipeline[]               @relation("PipelineCreator")
  createdWebForms                WebForm[]                @relation("WebFormCreator")
  createdSMSCampaigns            SMSCampaign[]            @relation("SMSCampaignCreator")
  createdWhatsAppCampaigns       WhatsAppCampaign[]       @relation("WhatsAppCampaignCreator")
  whatsAppMessages               WhatsAppMessage[]        @relation("WhatsAppMessageAgent")
  createdWhatsAppAccounts        WhatsAppAccount[]        @relation("WhatsAppAccountCreator")
  createdWhatsAppAssignmentRules WhatsAppAssignmentRule[] @relation("WhatsAppRuleCreator")
  createdWhatsAppFlows           WhatsAppFlow[]           @relation("WhatsAppFlowCreator")
  commissions                    Commission[]             @relation("UserCommission")
  createdCommissions             Commission[]             @relation("CommissionCreator")
  createdLandingPages            LandingPage[]            @relation("LandingPageCreator")
  auditLogs                      AuditLog[]               @relation("AuditActor")
  searchHistory                  SearchHistory[]          @relation("UserSearchHistory")
  createdDocuments               Document[]               @relation("DocumentCreator")
  teamId                         String?
  team                           Team?                    @relation(fields: [teamId], references: [id])
  createdTeams                   Team[]                   @relation("TeamCreator")
  managedTeams                   Team[]                   @relation("TeamManager")
  sharedProducts                 ProductShare[]
  branchId                       String?
  branch                         Branch?                  @relation(fields: [branchId], references: [id])
  managedBranches                Branch[]                 @relation("BranchManager")
  createdPaymentRecords          PaymentRecord[]          @relation("PaymentRecordCreator")
  reportedIssues                 IssueReport[]            @relation("IssueReporter")
  issueReplies                   IssueReply[]             @relation("IssueReplyAuthor")
  helperActivityLogs             HelperActivityLog[]
  reviewedEnquiries              Enquiry[]
  sentBroadcasts                 Broadcast[]              @relation("BroadcastSender")

  @@index([organisationId])
  @@index([email])
  @@index([role])
  @@index([teamId])
  @@index([branchId])
}

model Team {
  id             String    @id @default(uuid())
  name           String
  description    String?
  managerId      String?
  createdById    String
  organisationId String
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members                 User[]
  manager                 User?                    @relation("TeamManager", fields: [managerId], references: [id])
  createdBy               User                     @relation("TeamCreator", fields: [createdById], references: [id])
  organisation            Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  salesTargets            SalesTarget[]
  whatsAppAssignmentRules WhatsAppAssignmentRule[]

  @@index([organisationId])
}

model Notification {
  id              String     @id @default(uuid())
  title           String
  message         String
  type            String     @default("info")
  // Only meaningful for `type: "popup"` broadcasts (see PersistentBroadcastModal
  // on the frontend) - drives which icon/accent color the popup shows.
  // "info" | "warning" | "critical" | "update". Regular per-event notifications
  // (lead assigned, re-enquiry, etc.) leave this at the default and it's unused.
  severity        String     @default("info")
  relatedResource String?
  relatedId       String?
  isRead          Boolean    @default(false)
  recipientId     String
  organisationId  String?
  // Set only for rows created by a platform-wide/admin broadcast (see
  // Broadcast model below) - lets the Super Admin panel compute per-org
  // acknowledgement counts for a given broadcast. Null for every other
  // (per-event) notification, which is the vast majority of rows.
  broadcastId     String?
  broadcast       Broadcast? @relation(fields: [broadcastId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  recipient       User       @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, isRead, organisationId])
  @@index([broadcastId])
}

// One row per broadcast sent from the Super Admin panel (or the
// scripts/broadcast.ts/.sh CLI, which hits the same endpoint) - the parent
// record that all of that broadcast's per-recipient Notification rows link
// back to via `Notification.broadcastId`, so the panel can show "X of Y
// users acknowledged, broken down by organisation."
model Broadcast {
  id             String         @id @default(uuid())
  title          String
  message        String
  severity       String         @default("info")
  audience       String // 'all' | 'admins' | 'self'
  recipientCount Int            @default(0)
  createdById    String?
  createdBy      User?          @relation("BroadcastSender", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  notifications  Notification[]
}

// One row per login — backs the mobile app's Settings > Devices screen
// ("where all is my account logged in") and lets a user remotely sign out
// one specific device instead of only the existing all-or-nothing
// `User.tokenVersion` bump (password change). A JWT issued at login embeds
// this row's `id` as `sessionId`; `protect` (authMiddleware.ts) checks it
// alongside `tokenVersion` on every request, so setting `revokedAt` here
// takes effect on that device's very next API call. Nullable/absent
// `sessionId` on older tokens (issued before this model existed) is treated
// as "not session-tracked" rather than rejected — see `protect`'s comment.
model UserSession {
  id             String    @id @default(uuid())
  userId         String
  organisationId String?
  // "android" | "ios" | "web" — whatever the client sends at login;
  // free-form rather than an enum since a new client type shouldn't need
  // a migration to identify itself.
  platform       String?
  // Human-readable device label the client builds itself (e.g. "Redmi
  // Note 12" from device_info_plus, or a browser+OS string for web) —
  // there's no reliable server-side way to derive this from a bare
  // User-Agent for native apps, so it's client-supplied, same as `platform`.
  deviceName     String?
  appVersion     String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastActiveAt   DateTime  @default(now())
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
}

model Lead {
  id                 String     @id @default(uuid())
  firstName          String
  lastName           String?
  email              String?
  phone              String
  secondaryPhone     String?
  phoneCountryCode   String? // e.g., "+1", "+91", "+44"
  country            String? // e.g., "United States", "India", "United Kingdom"
  countryCode        String? // ISO 3166-1 alpha-2 code, e.g., "US", "IN", "GB"
  company            String?
  enquiryAbout       String?
  jobTitle           String?
  address            Json?
  source             LeadSource @default(manual)
  sourceDetails      Json?
  leadScore          Int        @default(0)
  engagementScore    Int        @default(0)
  qualityScore       Int        @default(0)
  isHotLead          Boolean    @default(false)
  lastScoredAt       DateTime?
  status             String     @default("new")
  stage              String?
  customFields       Json?
  activities         Json?
  tags               String[]
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  organisationId     String
  assignedToId       String?
  teamId             String?
  managerExplanation String?
  previousOwnerId    String?
  rotationViolation  Boolean    @default(false)
  userExplanation    String?
  violationTime      DateTime?
  nextFollowUp       DateTime?

  // Re-enquiry tracking
  isReEnquiry     Boolean   @default(false)
  reEnquiryCount  Int       @default(0)
  lastEnquiryDate DateTime?
  lastContactDate DateTime?
  originalLeadId  String? // Reference to the original lead if this is a duplicate

  events                 CalendarEvent[]
  checkIns               CheckIn[]
  interactions           Interaction[]
  assignedTo             User?             @relation("AssignedTo", fields: [assignedToId], references: [id])
  organisation           Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  previousOwner          User?             @relation("LeadPreviousOwner", fields: [previousOwnerId], references: [id])
  createdById            String?
  createdBy              User?             @relation("LeadCreator", fields: [createdById], references: [id])
  history                LeadHistory[]
  tasks                  Task[]
  followUps              FollowUp[]
  emailLists             EmailList[]       @relation("EmailListToLead")
  whatsAppMessages       WhatsAppMessage[]
  documents              Document[]
  pipelineId             String?
  pipeline               Pipeline?         @relation(fields: [pipelineId], references: [id])
  potentialValue         Float             @default(0)
  products               LeadProduct[]
  convertedAccounts      Account[]         @relation("LeadToAccount")
  convertedContacts      Contact[]         @relation("LeadToContact")
  convertedOpportunities Opportunity[]     @relation("LeadToOpportunity")
  callRecordings         CallRecording[]
  branchId               String?
  branch                 Branch?           @relation(fields: [branchId], references: [id])

  @@unique([phone, organisationId, branchId])
  @@index([organisationId])
  @@index([assignedToId])
  @@index([status])
  @@index([isDeleted])
  @@index([firstName, lastName])
  @@index([pipelineId])
  @@index([countryCode])
  @@index([isReEnquiry])
  @@index([email])
  @@index([branchId])
  @@index([rotationViolation])
}

model CallRecording {
  id               String   @id @default(uuid())
  leadId           String?
  duration         Int      @default(0) // Duration in seconds (recording length)
  hardwareDuration Int? // Official carrier talk-time in seconds
  fileUrl          String // S3 or local path
  callType         String   @default("UNKNOWN") // INCOMING, OUTGOING, MISSED
  timestamp        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Account {
  id              String           @id @default(uuid())
  name            String
  industry        String?
  website         String?
  size            String?
  annualRevenue   Float?
  address         Json?
  phone           String?
  type            String           @default("prospect")
  customFields    Json?
  tags            String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  ownerId         String?
  organisationId  String
  parentAccountId String?
  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner           User?            @relation("AccountOwner", fields: [ownerId], references: [id])
  previousOwnerId String?
  previousOwner   User?            @relation("AccountPreviousOwner", fields: [previousOwnerId], references: [id])
  parentAccount   Account?         @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   Account[]        @relation("AccountHierarchy")
  events          CalendarEvent[]
  cases           Case[]
  checkIns        CheckIn[]
  contacts        Contact[]
  interactions    Interaction[]
  opportunities   Opportunity[]
  quotes          Quote[]
  tasks           Task[]
  followUps       FollowUp[]
  documents       Document[]
  leadId          String?
  lead            Lead?            @relation("LeadToAccount", fields: [leadId], references: [id])
  accountProducts AccountProduct[]
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])

  @@index([organisationId])
  @@index([name])
  @@index([branchId])
  @@index([ownerId])
}

model Contact {
  id               String            @id @default(uuid())
  firstName        String
  lastName         String
  email            String?
  phones           Json?
  jobTitle         String?
  department       String?
  address          Json?
  socialProfiles   Json?
  doNotEmail       Boolean           @default(false)
  doNotCall        Boolean           @default(false)
  leadSource       String?
  customFields     Json?
  tags             String[]
  lastActivity     DateTime?
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accountId        String?
  ownerId          String?
  organisationId   String
  events           CalendarEvent[]
  cases            Case[]
  checkIns         CheckIn[]
  account          Account?          @relation(fields: [accountId], references: [id])
  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner            User?             @relation("ContactOwner", fields: [ownerId], references: [id])
  previousOwnerId  String?
  previousOwner    User?             @relation("ContactPreviousOwner", fields: [previousOwnerId], references: [id])
  interactions     Interaction[]
  quotes           Quote[]
  tasks            Task[]
  followUps        FollowUp[]
  emailLists       EmailList[]       @relation("ContactToEmailList")
  opportunities    Opportunity[]     @relation("OpportunityContacts")
  whatsAppMessages WhatsAppMessage[]
  documents        Document[]
  leadId           String?
  lead             Lead?             @relation("LeadToContact", fields: [leadId], references: [id])
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id])

  @@index([organisationId])
  @@index([email])
  @@index([firstName, lastName])
  @@index([branchId])
  @@index([ownerId])
}

model Opportunity {
  id              String          @id @default(uuid())
  name            String
  amount          Float
  stage           String          @default("prospecting")
  probability     Float           @default(10)
  closeDate       DateTime?
  leadSource      String?
  description     String?
  customFields    Json?
  tags            String[]
  isDeleted       Boolean         @default(false)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  accountId       String
  ownerId         String?
  organisationId  String
  paymentStatus   String          @default("pending") // pending, partial, paid
  paymentDate     DateTime?
  events          CalendarEvent[]
  interactions    Interaction[]
  account         Account         @relation(fields: [accountId], references: [id])
  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner           User?           @relation("OpportunityOwner", fields: [ownerId], references: [id])
  previousOwnerId String?
  previousOwner   User?           @relation("OpportunityPreviousOwner", fields: [previousOwnerId], references: [id])
  quotes          Quote[]
  tasks           Task[]
  followUps       FollowUp[]
  contacts        Contact[]       @relation("OpportunityContacts")
  documents       Document[]
  leadId          String?
  lead            Lead?           @relation("LeadToOpportunity", fields: [leadId], references: [id])
  pipelineId      String?
  pipeline        Pipeline?       @relation(fields: [pipelineId], references: [id])
  lostReason      String?
  emiSchedule     EMISchedule?
  paymentRecords  PaymentRecord[]
  leadStatus      String?
  type            OpportunityType @default(NEW_BUSINESS)
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])

  @@index([organisationId])
  @@index([stage])
  @@index([accountId])
  @@index([pipelineId])
  @@index([branchId])
  @@index([ownerId])
}

enum OpportunityType {
  NEW_BUSINESS
  UPSALE
}

model Product {
  id              String           @id @default(uuid())
  name            String
  sku             String?
  description     String?
  basePrice       Float
  currency        String           @default("INR")
  taxRate         Float            @default(0)
  category        String?
  tags            String[]
  unit            String           @default("unit")
  minQuantity     Int              @default(1)
  maxQuantity     Int?
  imageUrl        String?
  isActive        Boolean          @default(true)
  isCustom        Boolean          @default(false)
  isOrgProduct    Boolean          @default(false)
  brochureUrl     String?
  validFrom       DateTime?
  validUntil      DateTime?
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  organisationId  String
  createdBy       User?            @relation("ProductCreator", fields: [createdById], references: [id])
  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  quoteItems      QuoteLineItem[]
  accountProducts AccountProduct[]
  salesTargets    SalesTarget[]
  leads           LeadProduct[]
  productShares   ProductShare[]
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model LeadProduct {
  id         String  @id @default(uuid())
  leadId     String
  productId  String
  quantity   Int     @default(1)
  price      Float
  customName String?
  lead       Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@unique([leadId, productId])
}

model AccountProduct {
  id           String    @id @default(uuid())
  quantity     Float     @default(1)
  purchaseDate DateTime?
  serialNumber String?
  status       String    @default("active") // active, churned, returned
  notes        String?
  price        Float     @default(0)
  customName   String?

  accountId      String
  productId      String
  organisationId String

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([productId])
  @@index([organisationId])
}

model Quote {
  id                 String          @id @default(uuid())
  quoteNumber        String          @unique
  title              String
  description        String?
  subtotal           Float
  totalDiscount      Float           @default(0)
  totalTax           Float           @default(0)
  grandTotal         Float
  currency           String          @default("USD")
  validUntil         DateTime
  paymentTerms       String?
  termsAndConditions String?
  notes              String?
  status             String          @default("draft")
  version            Int             @default(1)
  sentAt             DateTime?
  viewedAt           DateTime?
  respondedAt        DateTime?
