// EMI Payment System Models

model EMISchedule {
  id              String    @id @default(uuid())
  opportunityId   String    @unique
  totalAmount     Float // Remaining amount at time of EMI creation
  paidAmount      Float     @default(0)
  remainingAmount Float
  status          EMIStatus @default(active)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organisationId  String

  opportunity  Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  installments EMIInstallment[]

  @@index([opportunityId])
  @@index([status])
  @@index([organisationId])
}

enum EMIStatus {
  active
  completed
  cancelled
  defaulted
}

model EMIInstallment {
  id                String            @id @default(uuid())
  scheduleId        String
  installmentNumber Int
  amount            Float
  paidAmount        Float             @default(0)
  dueDate           DateTime
  status            InstallmentStatus @default(pending)
  paidDate          DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  schedule       EMISchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  paymentRecords PaymentRecord[]

  @@index([scheduleId])
  @@index([status])
  @@index([dueDate])
}

enum InstallmentStatus {
  pending
  paid
  overdue
  cancelled
  missed
}

model PaymentRecord {
  id             String      @id @default(uuid())
  opportunityId  String
  amount         Float
  paymentDate    DateTime    @default(now())
  paymentMethod  String? // cash, card, bank_transfer, etc.
  paymentType    PaymentType @default(full)
  installmentId  String?
  notes          String?
  createdAt      DateTime    @default(now())
  createdById    String
  organisationId String

  opportunity  Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  installment  EMIInstallment? @relation(fields: [installmentId], references: [id])
  createdBy    User            @relation("PaymentRecordCreator", fields: [createdById], references: [id])
  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([installmentId])
  @@index([organisationId])
  @@index([paymentDate])
}

enum PaymentType {
  full
  partial
  installment
}

// Public "Enquire" submissions from the landing page - deliberately NOT an
// instant self-serve signup (see `authController.registerUser` for that).
// A super admin reviews each one and, if legitimate, converts it into a real
// Organisation + admin User via `convertEnquiryToAccount`.
model Enquiry {
  id                      String        @id @default(uuid())
  companyName             String
  firstName               String
  lastName                String?
  email                   String
  phone                   String?
  message                 String?
  status                  String        @default("pending") // pending | converted | rejected
  convertedOrganisationId String?       @unique
  convertedOrganisation   Organisation? @relation(fields: [convertedOrganisationId], references: [id])
  reviewedById            String?
  reviewedBy              User?         @relation(fields: [reviewedById], references: [id])
  reviewedAt              DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([status])
}

model SiteFAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Training/Help Center video guides, managed by Super Admin and shown on the
// in-app Training page (Dad-frontend's /training). Global/platform content,
// not tenant-scoped — same pattern as SiteFAQ above.
model TrainingVideo {
  id           String   @id @default(uuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  category     String? // free-form label matching a Training page module, e.g. "Lead Management"
  duration     String? // display string, e.g. "4:32" — not enforced/parsed
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
